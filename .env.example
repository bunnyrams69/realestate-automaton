# ==============================================================================
# Real Estate AI Sales & Marketing Automation Platform
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to '.env' for local development.
# - NEVER commit real credentials, API tokens, or secrets to version control.
# - In production (Render/Vercel), configure these via environment dashboards.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core
# ------------------------------------------------------------------------------
APP_NAME="Real Estate AI Sales & Marketing Automation"
APP_ENV="development"                  # development | staging | production
DEBUG=true
LOG_LEVEL="INFO"                       # DEBUG | INFO | WARNING | ERROR
SECRET_KEY="replace-with-a-secure-random-32-byte-secret-key"
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Public URL used for incoming webhooks (e.g., Cloudflare Quick Tunnel in dev)
# Example: https://sample-tunnel.trycloudflare.com
WEBHOOK_BASE_URL=""

# ------------------------------------------------------------------------------
# 2. Anthropic / Claude API (AI Reasoning & Extraction)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-api03-placeholder-key"
CLAUDE_MODEL="claude-3-7-sonnet-20250219"     # Default reasoning & orchestration model
CLAUDE_FAST_MODEL="claude-3-5-haiku-20241022" # Fast lightweight intent detection / routing
CLAUDE_MAX_TOKENS=1024
CLAUDE_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# 3. WhatsApp Business Platform Cloud API (Meta)
# ------------------------------------------------------------------------------
# Meta App Webhook Verification Token (custom string configured in Meta App Dashboard)
WHATSAPP_VERIFY_TOKEN="your-custom-verify-token-string"
# Meta App Secret (used for verifying sha256 signature in X-Hub-Signature-256 header)
WHATSAPP_APP_SECRET="your-meta-app-secret-placeholder"
# WhatsApp Phone Number ID (from WhatsApp Business Cloud API setup)
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID="your-waba-id"
# System User Access Token with whatsapp_business_messaging permissions
WHATSAPP_API_TOKEN="EAAB...placeholder-whatsapp-access-token"
WHATSAPP_API_VERSION="v21.0"

# ------------------------------------------------------------------------------
# 4. Database (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (async driver: asyncpg, sync driver: psycopg2)
# Supabase connection pooled connection string:
DATABASE_URL="postgresql+asyncpg://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres"
SYNC_DATABASE_URL="postgresql://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres"

# Supabase direct API access (optional for storage / dashboard direct queries)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi...placeholder-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...placeholder-service-role-key"

# ------------------------------------------------------------------------------
# 5. Google Calendar API (Site Visit Scheduling)
# ------------------------------------------------------------------------------
# Service Account JSON key path or base64-encoded string
GOOGLE_CALENDAR_CREDENTIALS_FILE="credentials/google-calendar-service-account.json"
GOOGLE_CALENDAR_ID="primary"           # Calendar ID for site visit bookings
DEFAULT_SITE_VISIT_DURATION_MINUTES=45

# ------------------------------------------------------------------------------
# 6. Meta Marketing API (Read-only Campaign Insights)
# ------------------------------------------------------------------------------
META_ACCESS_TOKEN="EAAB...placeholder-meta-marketing-token"
META_AD_ACCOUNT_ID="act_1234567890"

# ------------------------------------------------------------------------------
# 7. Business Logic & Qualification Thresholds
# ------------------------------------------------------------------------------
# Lead Scoring Thresholds (0 - 100)
LEAD_SCORE_HOT_THRESHOLD=75            # Score >= 75 classified as HOT
LEAD_SCORE_WARM_THRESHOLD=45           # Score 45-74 classified as WARM (< 45 is COLD)
DEFAULT_FOLLOW_UP_INTERVAL_HOURS=24
MAX_FOLLOW_UP_ATTEMPTS=4
ENABLE_HUMAN_HANDOFF_NOTIFICATION=true
ADMIN_NOTIFICATION_EMAIL="sales-lead@yourcompany.com"
